# =============================================================================
# Votometro · .env.example — plantilla de variables
# -----------------------------------------------------------------------------
# Copiar a `.env` (no versionado, ignorado por .gitignore) y rellenar con
# valores reales ANTES de ejecutar `docker compose up`.
#
# REGLAS:
#   1. NUNCA versionar el .env real (ya está en .gitignore).
#   2. NUNCA pegar secretos (SQL_CONNECTION_STRING, FUNCTIONS_SECRET) en
#      ningún canal distinto de Azure Key Vault, 1Password o el gestor de
#      secretos del equipo.
#   3. Todo valor con `CHANGEME_` debe reemplazarse; docker-compose no
#      arrancará si detecta placeholders en ejecución productiva.
# =============================================================================

# --- Base de Datos (SQL Server 2022 local) ----------------------------------
# Password para el usuario SA del contenedor. Requisitos SQL Server 2022:
#   · 8+ caracteres · mayúsculas + minúsculas + número + símbolo
MSSQL_SA_PASSWORD=CHANGEME_Strong_Sa_Password_123!
MSSQL_DB_NAME=sqldb-ingenial-ia

# --- Backend (Azure Functions) ----------------------------------------------
# Identidad de Azure AD + Power BI (los usa shared/utils.py y power_bi_auth.py)
TENANT_ID=CHANGEME_tenant_guid
MS_CLIENT_ID=CHANGEME_backend_app_registration_guid
MS_CLIENT_SECRET=CHANGEME_backend_app_client_secret
POWER_BI_GROUP_ID=CHANGEME_powerbi_workspace_guid

# Cadena de conexión usada por el backend (pyodbc · ODBC Driver 18).
# En compose, `database` es el nombre DNS del service; en producción,
# reemplazar por el FQDN de Azure SQL. `TrustServerCertificate=yes` es
# aceptable SOLO en dev (el cert del contenedor es self-signed).
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:database,1433;Database=sqldb-ingenial-ia;Uid=SA;Pwd=CHANGEME_Strong_Sa_Password_123!;Encrypt=yes;TrustServerCertificate=yes;Connection Timeout=30;

# Function Key — generada en Azure Portal (Functions → App Keys).
# En local `compose up` la inyecta al backend para cumplir AuthLevel.FUNCTION
# de `GET /power-bi/{reportId}`. Rotarla si se filtra.
AZURE_FUNCTIONS_MASTER_KEY=CHANGEME_local_function_master_key

# --- Bootstrap del primer Admin local (opcional) ---------------------------
# Si seteas estas DOS variables, db-init (vía 04_bootstrap_admin.sql)
# inserta o promueve a `Admin + enable=1` el usuario con el OID dado.
# Sin estas variables el script entra en NO-OP y el sidebar de admin
# nunca aparecerá hasta que crees el usuario manualmente.
#
# Cómo obtener el OID la primera vez:
#   1. Loguéate en la app (la sesión queda creada en sessionStorage aunque
#      el sidebar no aparezca).
#   2. F12 → Application → sessionStorage → busca la clave que termina
#      en `.idtoken`. Pega el valor en jwt.ms y copia el claim `oid`.
#   3. Pega ese UUID acá y vuelve a hacer `docker compose up`.
BOOTSTRAP_ADMIN_OID=
BOOTSTRAP_ADMIN_EMAIL=

# --- Frontend (Vite / React) ------------------------------------------------
# Valores PÚBLICOS embebidos al bundle — no incluir secretos aquí.
VITE_BACKEND_URL=http://localhost:7071/api
VITE_AZURE_CLIENT_ID=CHANGEME_frontend_spa_app_registration_guid
VITE_AZURE_TENANT_ID=CHANGEME_tenant_guid

# --- Correo electrónico (SMTP) — Notificaciones de bienvenida ---------------
# Usado por shared/email_service.py para enviar credenciales al crear usuarios.
# Si estas variables no están definidas, el sistema crea el usuario igualmente
# pero omite el envío del correo (se registra un warning en los logs).
#
# Ejemplos de configuración comunes:
#   · Office 365/Exchange: HOST=smtp.office365.com  PORT=587  (STARTTLS)
#   · Gmail (App Password): HOST=smtp.gmail.com     PORT=587  (STARTTLS)
#   · SendGrid SMTP API:    HOST=smtp.sendgrid.net  PORT=587  (STARTTLS)
#   · SSL directo:          PORT=465 (usa SMTP_SSL en lugar de STARTTLS)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=CHANGEME_noreply@tu-dominio.com
SMTP_PASS=CHANGEME_app_password_o_secreto_smtp
SMTP_FROM_NAME=Ingenial IA · Votómetro

# URL base del frontend — se usa como enlace "Acceder a la Plataforma" en el email.
# En local: http://localhost:8080   |   En producción: https://votometro.ingenial-ia.com
FRONTEND_URL=http://localhost:8080

# --- Límites de recursos para compose (opcional) ---------------------------
# Si se desea override del default por servicio. Unidad: CPU cores + MiB.
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=1g
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=256m
